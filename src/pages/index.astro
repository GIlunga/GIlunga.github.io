---
import Layout from "@layouts/Layout.astro"
import Container from "@components/Container.astro"
import { HOME } from "@consts"
import ArrowCard from "@components/ArrowCard.astro"
import Link from "@components/Link.astro"
import { getCollection, type CollectionEntry } from "astro:content"

const data = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

type Acc = {
  [year: string]: CollectionEntry<"blog">[]
}

const posts = data.reduce((acc: Acc, post) => {
  const year = post.data.date.getFullYear().toString()
  if (!acc[year]) {
    acc[year] = []
  }
  acc[year].push(post)
  return acc
}, {})

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a))
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <aside class="pt-8">
      <div class="space-y-16">
        <section>
          <article class="space-y-4">
            <p>
              Hey, I'm Gui, a machine learning engineer, and this is my website. Currently, I work
              on the matching algorithm at Bumble. Previously, I worked on purchase prediction for
              Amazon and on several research projects at Microsoft Research (e.g., <Link
                href="https://dl.acm.org/doi/pdf/10.1145/3708993">holographic storage devices</Link
              >).
            </p>

            <p>
              Here you will find <b>human-generated</b> paper summaries, deep-dives, and project reports.
              If you find any issue in the posts or just want to say hi, then reach out on <Link
                href="https://www.linkedin.com/in/gilunga/">LinkedIn</Link
              >.
            </p>
          </article>

          <section class="animate space-y-4">
            <h2 class="font-semibold text-black dark:text-white">All posts</h2>
            <div class="space-y-10">
              {
                years.map((year) => (
                  <section class="space-y-4">
                    <div class="font-semibold text-black dark:text-white">{year}</div>
                    <ul class="not-prose flex flex-col gap-4">
                      {posts[year].map((post) => (
                        <li>
                          <ArrowCard entry={post} />
                        </li>
                      ))}
                    </ul>
                  </section>
                ))
              }
            </div>
          </section>
        </section>
      </div>
    </aside>
  </Container>
</Layout>
